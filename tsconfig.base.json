{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ESNext",
    "lib": ["ESNext"],

    // TypeScript 7 no longer auto-includes every package under node_modules/@types,
    // so every ambient type package has to be listed explicitly.
    "types": ["node"],

    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": false,
    "esModuleInterop": true,
    "skipLibCheck": true,

    // Emit is opt-in: a package that builds sets "noEmit": false alongside an
    // "outDir". Everything else is run straight from source by Node's type
    // stripping, so tsc only ever typechecks.
    "noEmit": true
  }
}
