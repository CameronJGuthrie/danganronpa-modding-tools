{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [],
      "project": []
    },
    "packages/lin-compiler": {
      "entry": [
        "test/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts",
        "test/**/*.ts"
      ]
    },
    "projects/cli": {
      "project": [
        "src/**/*.ts"
      ]
    },
    "packages/scripts": {
      "entry": [
        "src/{formats,setup,mod,game,explore}/*.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "projects/vscode-extension": {
      "entry": [
        "src/test/**/*.ts",
        "src/syntaxes/tmlanguage-builder.ts"
      ],
      "project": [
        "src/**/*.ts"
      ],
      "ignoreDependencies": [
        "@vscode/test-electron"
      ]
    }
  },
  "ignoreBinaries": [
    "x-terminal-emulator"
  ]
}
