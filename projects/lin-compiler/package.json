{
  "name": "lin-compiler",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Danganronpa script (de)compiler between binary .lin and human-readable .linscript",
  "bin": {
    "lin-compiler": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
