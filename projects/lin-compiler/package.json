{
  "name": "lin-compiler",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Danganronpa script (de)compiler between binary .lin and human-readable .linscript",
  "bin": {
    "lin-compiler": "./src/cli.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json",
    "test": "node --test 'test/**/*.test.ts'"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "catalog:"
  }
}
