{
  "scopeName": "source.linscript",
  "patterns": [
    {
      "match": "#.*$",
      "name": "comment.line.number-sign.linscript"
    },
    {
      "match": "\\b0x[0-9A-Fa-f]+\\b",
      "name": "constant.numeric.hex.linscript"
    },
    {
      "match": "\"(?:[^\"\\\\]|\\\\.)*\"",
      "name": "string.quoted.double.linscript"
    },
    {
      "match": "\\b(Animation|AutoText|CameraFlash|CheckCharacter|CheckObject|EndOfJump|Goto|If|IfFlag|IfFreeTimeEvent|IfRelationship|Label|LoadMap|LoadScript|LoadSprite|Movie|Music|ObjectState|PostProcessingEffect|Present|RestartScript|RunScript|ScreenFade|ScreenFlash|SetFlag|SetOption|SetUI|SetVariable|ShowBackground|Sound|SoundB|Speaker|Sprite|SpriteFlash|StopScript|StudentRelationship|StudentReportInfo|StudentTitleEntry|Text|TextStyle|Then|TrialCamera|TruthBulletFlag|UnlockSkill|Voice|WaitFrame|WaitInput)\\b",
      "name": "entity.name.function.linscript"
    },
    {
      "match": "\\b[A-Za-z_]\\w*\\b",
      "name": "variable.other.enummember.linscript"
    }
  ]
}
