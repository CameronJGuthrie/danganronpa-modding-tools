{
  "scopeName": "source.linscript",
  "patterns": [
    {
      "match": "#.*$",
      "name": "comment.line.number-sign.linscript"
    },
    {
      "match": "\"(?:[^\"\\\\]|\\\\.)*\"",
      "name": "string.quoted.double.linscript"
    },
    {
      "match": "\\b(Animation|DebateEnd|DebateStatement|FadeIn|FadeOut|FadeOutThenWait|CharacterName|Goto|If|IfFlag|IfFreeTimeEvent|IfRelationship|Label|LabelName|LoadMap|LoadScript|MapCharacter|MapClearAll|MapClearCharacterStatus|MapClearPositions|MapIcons|Meta|Mode|Movie|Music|ObjectName|ObjectState|OnCharacter|OnDebateCounter|OnDebateHit|OnDebateInfluenceEmpty|OnDebateLoop|OnDebateMiss|OnDebateTimeout|OnDebateUnknown|OnObject|Option|OptionName|PlaceSprite|PostProcessingEffect|GivePresent|ReceivePresent|RawText|Return|RunScript|SceneFlagName|ScreenFlash|SetFlag|SetOption|SetUI|SetVariable|ShowBackground|Sound|SoundB|Speaker|Sprite|SpriteFlash|StopScript|StudentRelationship|StudentReportInfo|StudentTitleEntry|Text|TextEager|TextStyle|Time|TrialCamera|TruthBulletFlag|UnlockSkill|Voice|Wait|WaitFrame|WaitInput)\\b",
      "name": "entity.name.function.linscript"
    },
    {
      "match": "\\b[A-Za-z_]\\w*\\b",
      "name": "variable.other.enummember.linscript"
    }
  ]
}
