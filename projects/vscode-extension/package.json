{
  "name": "lindecompilerhelper",
  "displayName": "LinDecompilerHelper",
  "description": "Syntax highlighting and live compilation for Danganronpa .linscript files",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:linscript",
    "workspaceContains:**/*.lin",
    "workspaceContains:**/*.linscript"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "linscript",
        "extensions": [
          ".linscript"
        ],
        "aliases": [
          "Lin Script Language"
        ]
      }
    ],
    "grammars": [
      {
        "language": "linscript",
        "scopeName": "source.linscript",
        "path": "./src/syntaxes/linscript.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "lindecompilerhelper.selectScript",
        "title": "Select for Modding"
      },
      {
        "command": "lindecompilerhelper.verifyFile",
        "title": "Verify File"
      },
      {
        "command": "lindecompilerhelper.selectPak",
        "title": "Select PAK for Modding"
      },
      {
        "command": "lindecompilerhelper.toggleParameterDecorations",
        "title": "LinScript: Toggle Parameter Decorations"
      },
      {
        "command": "lindecompilerhelper.toggleFunctionDecorations",
        "title": "LinScript: Toggle Function Decorations"
      },
      {
        "command": "lindecompilerhelper.chooseWorkbenchRoot",
        "title": "LinScript: Choose Workbench Folder"
      },
      {
        "command": "lindecompilerhelper.stopAudio",
        "title": "LinScript: Stop All Audio"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "when": "resourceExtname =~ /\\.(lin|linscript)$/",
          "command": "lindecompilerhelper.selectScript",
          "group": "navigation"
        },
        {
          "when": "resourceExtname == .lin",
          "command": "lindecompilerhelper.verifyFile",
          "group": "navigation"
        },
        {
          "when": "explorerResourceIsFolder && resourcePath in lindecompilerhelper.pakFolders",
          "command": "lindecompilerhelper.selectPak",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "LinScript",
      "properties": {
        "lindecompilerhelper.workbenchRoot": {
          "type": "string",
          "default": "workbench",
          "scope": "resource",
          "markdownDescription": "The workbench folder holding the extracted game data (`base_files/`, `exploration/`, `mod/<name>/`). A relative path is resolved against the first workspace folder; the default finds the repository's own `workbench/`. Run **LinScript: Choose Workbench Folder** to pick one."
        },
        "lindecompilerhelper.decorationAlignmentColumn": {
          "type": "number",
          "default": 40,
          "minimum": 1,
          "maximum": 200,
          "description": "Column at which to align function decorations (e.g., voice line previews)"
        },
        "lindecompilerhelper.showParameterDecorations": {
          "type": "boolean",
          "default": true,
          "description": "Show parameter name decorations (e.g., 'character=', 'flag=')"
        },
        "lindecompilerhelper.showFunctionDecorations": {
          "type": "boolean",
          "default": true,
          "description": "Show function decorations (e.g., voice line previews, character names)"
        }
      }
    },
    "keybindings": [
      {
        "command": "lindecompilerhelper.toggleParameterDecorations",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p",
        "when": "editorLangId == linscript"
      },
      {
        "command": "lindecompilerhelper.toggleFunctionDecorations",
        "key": "ctrl+alt+f",
        "mac": "cmd+alt+f",
        "when": "editorLangId == linscript"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile && pnpm run bundle",
    "compile": "tsc -p ./ && pnpm run bundle",
    "bundle": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=out/extension.js && esbuild src/worker/compiler-worker.ts --bundle --platform=node --format=cjs --outfile=out/compiler-worker.js && esbuild src/test/*.test.ts --bundle --platform=node --format=cjs --external:vscode --external:mocha --outdir=out/test",
    "build-grammar": "esbuild src/syntaxes/tmlanguage-builder.ts --bundle --platform=node --format=cjs --outfile=out/syntaxes/tmlanguage-builder.js && node out/syntaxes/tmlanguage-builder.js",
    "typecheck": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "pnpm run compile && pnpm run lint",
    "package": "vsce package --allow-missing-repository --no-dependencies --",
    "install-extension": "(code --uninstall-extension lindecompilerhelper || true) && pnpm package && code --install-extension lindecompilerhelper-0.0.1.vsix && rm lindecompilerhelper-0.0.1.vsix",
    "lint": "biome lint src",
    "format": "biome check src",
    "test": "vscode-test"
  },
  "dependencies": {
    "danganronpa-scripts": "workspace:*",
    "lin-compiler": "workspace:*",
    "linscript-definitions": "workspace:*"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.4",
    "@types/vscode": "^1.94.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "catalog:"
  }
}
