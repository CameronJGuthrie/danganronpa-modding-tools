{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noEmit": false,
    "rootDir": "src",
    "outDir": "out",
    "declaration": true,
    "sourceMap": true
  },
  "include": ["src/**/*.ts"]
}
