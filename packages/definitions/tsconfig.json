{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Emitted as CommonJS (no "type": "module" in package.json) so the VS Code extension host can
    // require() it directly; ESM consumers can import the named exports as usual.
    "target": "ES2023",
    "lib": ["ES2023"],
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "sourceMap": true
  },
  "include": ["src/**/*.ts"]
}
