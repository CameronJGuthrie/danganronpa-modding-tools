{
  "name": "danganronpa-modding-tools",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "lint": "biome lint",
    "lint:fix": "biome check --fix --unsafe",
    "start": "pnpm run build && pnpm run game",
    "ext": "pnpm --filter lindecompilerhelper install-extension",
    "reset": "node packages/scripts/src/setup/extract-linscript.ts",
    "reset-hex": "node packages/scripts/src/setup/extract-linscript.ts --hex",
    "unpack": "node packages/scripts/src/setup/unpack-base-files.ts",
    "extract-recursive": "node packages/scripts/src/setup/extract-recursive.ts",
    "extract-recursive:all": "node packages/scripts/src/setup/extract-recursive.ts workbench/all/dr1_data_us.wad && node packages/scripts/src/setup/extract-recursive.ts workbench/all/dr1_data.wad && node packages/scripts/src/setup/extract-recursive.ts workbench/all/dr1_data_keyboard_us.wad && node packages/scripts/src/setup/extract-recursive.ts workbench/all/dr1_data_keyboard.wad",
    "setup": "node packages/scripts/src/setup/zip-game-files.ts && pnpm run unpack && pnpm run reset",
    "select": "node packages/scripts/src/mod/select.ts",
    "verify": "node packages/scripts/src/mod/verify.ts",
    "build": "node packages/scripts/src/mod/build.ts",
    "clear-proton": "node packages/scripts/src/game/clear-proton.ts",
    "copy": "node packages/scripts/src/explore/generator.ts",
    "game": "node packages/scripts/src/game/launch-game.ts",
    "investigate": "node packages/scripts/src/explore/investigate.ts",
    "validate-paks": "node packages/scripts/src/setup/validate-paks.ts",
    "test:all": "pnpm -r --if-present run test ",
    "lint:all": "pnpm -r --if-present run lint ",
    "knip": "knip"
  },
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457",
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "knip": "^6.34.0"
  }
}
