{
  "name": "danganronpa-modding-tools",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "lint": "biome check",
    "lint:fix": "biome check --write --unsafe",
    "start": "pnpm run stop && pnpm run build && pnpm run game",
    "ext": "pnpm --filter lindecompilerhelper install-extension",
    "reset": "node packages/scripts/src/setup/extract-linscript.ts",
    "extract-recursive": "node packages/scripts/src/setup/extract-recursive.ts",
    "extract-recursive:all": "node packages/scripts/src/setup/extract-recursive.ts dr1_data_us.wad && node packages/scripts/src/setup/extract-recursive.ts dr1_data.wad && node packages/scripts/src/setup/extract-recursive.ts dr1_data_keyboard_us.wad && node packages/scripts/src/setup/extract-recursive.ts dr1_data_keyboard.wad",
    "setup": "node packages/scripts/src/setup/backup-game-files.ts && pnpm run reset",
    "select": "node packages/scripts/src/mod/select.ts",
    "build": "node packages/scripts/src/mod/build.ts",
    "game": "node packages/scripts/src/game/launch-game.ts",
    "stop": "node packages/scripts/src/game/stop-game.ts",
    "gui": "pnpm -C projects/gui run start",
    "investigate": "node packages/scripts/src/explore/investigate.ts",
    "test": "pnpm -r --if-present run test ",
    "knip": "knip"
  },
  "packageManager": "pnpm@12.9.1",
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "knip": "^6.39.0"
  }
}
